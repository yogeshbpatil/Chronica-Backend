# Database Configuration
# Local PostgreSQL. The @ in Admin@123 is URL-encoded as %40.
# For Render, replace this entire value with Neon's pooled connection string
# and change its scheme from postgresql:// to postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://postgres:Admin%40123@localhost:5432/chronica_database

# JWT Configuration
SECRET_KEY=development-only-secret-key-change-in-render
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# API Configuration
API_TITLE=Chronica API
API_VERSION=1.0.0
API_DESCRIPTION=Personal Knowledge Management Platform Backend

# Environment
ENVIRONMENT=production
DEBUG=False

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
